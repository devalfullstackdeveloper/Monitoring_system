# For local testing only:
# BACKEND_URL=http://localhost:8000
#
# For a real organization rollout, this MUST point at your central backend
# server's real address (not localhost — localhost means "this machine",
# which is wrong on every employee's PC). Examples:
#   BACKEND_URL=http://192.168.1.50:8000       (server's LAN IP)
#   BACKEND_URL=https://tracker.yourcompany.com (a real domain, recommended)
BACKEND_URL=http://localhost:8000

SCREENSHOT_INTERVAL_SECONDS=300
SCREENSHOT_NOTIFICATIONS_ENABLED=true
AUTO_START_TRACKING=true

# When packaged as OrgTrackerAgent.exe, this .env file must sit in the SAME
# folder as the .exe — that's how each employee machine gets pointed at
# your organization's backend without rebuilding the executable per machine.
